APP_NAME="Refrigerant Leak Detection API"
APP_ENV=development
APP_VERSION=0.1.0

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=hvac_leak_detection

INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=your-org-name
INFLUXDB_BUCKET=hvac_sensor_data

JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

INGESTION_API_KEY=replace_with_a_unique_ingestion_key

# Path to the 4 real trained model files (isolation_forest_r32.pkl,
# lstm_leak_forecast.h5, lstm_scaler.pkl, random_forest_severity.pkl)
MODEL_DIR=app/ai/models

# ---- SMS Gateway Configuration (Admin Notifications) ----
# Choose active SMS provider: "textbee" (default / Android device gateway) or "twilio"
SMS_PROVIDER=textbee

# TextBee Configuration (Free Android Gateway using your own SIM card)
# 1. Sign up at https://textbee.dev
# 2. Install the TextBee app on your Android phone with an active SIM card
# 3. Copy your API Key and Device ID from your TextBee dashboard
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here

# Twilio Configuration (Alternative cloud provider)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890


